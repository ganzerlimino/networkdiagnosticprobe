[Unit]
Description=Network Diagnostic Probe
Documentation=https://github.com/networkdiagnosticprobe/networkdiagnosticprobe
After=network-online.target lldpd.service
Wants=network-online.target lldpd.service

[Service]
Type=simple
User=root
Group=root
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ndp/venv/bin/ndp --config /etc/ndp/config.yaml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
