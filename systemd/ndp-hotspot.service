[Unit]
Description=NDP Wi-Fi hotspot for phone access
Documentation=https://github.com/networkdiagnosticprobe/networkdiagnosticprobe
After=network-pre.target
Before=ndp.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ndp/venv/bin/ndp hotspot start --config /etc/ndp/config.yaml
ExecStop=/opt/ndp/venv/bin/ndp hotspot stop --config /etc/ndp/config.yaml

[Install]
WantedBy=multi-user.target
